generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── User plan (LemonSqueezy) ──────────────────────────────────────────────────
model UserPlan {
  id                   String    @id @default(cuid())
  userId               String    @unique
  plan                 String    @default("free")       // free | pro | business
  lsCustomerId         String?                           // LemonSqueezy customer id
  lsSubscriptionId     String?                           // LemonSqueezy subscription id
  lsVariantId          String?                           // plan variant
  lsCurrentPeriodEnd   DateTime?
  lsStatus             String?                           // active | cancelled | past_due
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// ── Accounts (per-user, encrypted credentials) ───────────────────────────────
model Account {
  id              String              @id @default(cuid())
  userId          String
  name            String
  type            String
  platform        String
  credentialsJson String
  isActive        Boolean             @default(true)
  lastSynced      DateTime?
  createdAt       DateTime            @default(now())
  snapshots       PortfolioSnapshot[]
  transactions    Transaction[]
}

model PortfolioSnapshot {
  id            String   @id @default(cuid())
  userId        String
  accountId     String?
  account       Account? @relation(fields: [accountId], references: [id])
  date          DateTime
  totalValue    Float
  breakdownJson String
  createdAt     DateTime @default(now())
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  asset     String
  type      String
  amount    Float
  price     Float?
  fee       Float    @default(0)
  currency  String   @default("USD")
  timestamp DateTime
  createdAt DateTime @default(now())
}

model Subscription {
  id          String   @id @default(cuid())
  userId      String
  name        String
  amount      Float
  currency    String   @default("USD")
  cadence     String
  category    String
  nextBilling DateTime
  logoUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model BudgetCategory {
  id        String   @id @default(cuid())
  userId    String
  name      String
  limit     Float
  color     String   @default("#3B82F6")
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

model Alert {
  id          String    @id @default(cuid())
  userId      String
  type        String
  asset       String?
  threshold   Float
  isActive    Boolean   @default(true)
  triggered   Boolean   @default(false)
  triggeredAt DateTime?
  createdAt   DateTime  @default(now())
}

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String
  timestamp DateTime @default(now())
}

model MarketCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  dataJson  String
  expiresAt DateTime
}

model UserSettings {
  id                String   @id @default(cuid())
  userId            String   @unique
  baseCurrency      String   @default("USD")
  riskProfile       String   @default("moderate")
  theme             String   @default("dark")
  alertPreferences  String   @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
