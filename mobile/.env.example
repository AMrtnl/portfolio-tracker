# Meridian iOS app — environment
# Copy to `.env` (git-ignored) and fill in. Never put brokerage keys here:
# anything prefixed EXPO_PUBLIC_ is embedded in the app binary and readable by
# anyone who downloads it.

# Base URL of YOUR OWN Meridian API deployment (Railway). No trailing slash.
# Simulator against a local server: http://localhost:4000
# Physical device against a local server: http://<your-mac-lan-ip>:4000
EXPO_PUBLIC_API_URL=https://your-meridian-api.up.railway.app

# ---------------------------------------------------------------------------
# Build-time only (not embedded in the JS bundle)
# ---------------------------------------------------------------------------

# Reverse-DNS bundle identifier you registered with Apple.
MERIDIAN_BUNDLE_ID=com.yourname.meridian

# Written by `eas init`; also lives in eas.json / app.config.ts extra.
# EAS_PROJECT_ID=

# ---------------------------------------------------------------------------
# NEVER add these — they belong only in the server's environment.
# SnapTrade's Personal API key identifies the account holder and must not be
# distributed inside an app. https://docs.snaptrade.com/docs/build-with-ai.md
# The login password is typed by the user at runtime, never stored here.
# ---------------------------------------------------------------------------
# SNAPTRADE_CLIENT_ID       ← server only
# SNAPTRADE_CONSUMER_KEY    ← server only
# APP_PASSWORD              ← server only
# SESSION_SECRET            ← server only
