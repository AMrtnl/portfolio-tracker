# FinVault Environment Variables
# Copy this file to .env and fill in your values

# ── Core ──────────────────────────────────────────────
PORT=4000
DATABASE_URL="file:./dev.db"
ENCRYPTION_KEY="change-me-to-a-32-char-secret!!"

# ── Wallet (for Hyperliquid / Polymarket / Aster) ─────
MNEMONIC="your twelve or twenty four word mnemonic phrase goes here"

# ── AI Advisor ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Market Data (free tiers) ──────────────────────────
FINNHUB_API_KEY=your_finnhub_key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
FRED_API_KEY=your_fred_key

# ── Crypto Exchanges (optional — add only what you use) ─
BINANCE_API_KEY=
BINANCE_API_SECRET=

BYBIT_API_KEY=
BYBIT_API_SECRET=

BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=

COINBASE_API_KEY=
COINBASE_API_SECRET=

KRAKEN_API_KEY=
KRAKEN_PRIVATE_KEY=

OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

GATE_API_KEY=
GATE_API_SECRET=

# ── Prediction Markets ────────────────────────────────
KALSHI_API_KEY=
POLYMARKET_PRIVATE_KEY=

# ── Traditional Finance ───────────────────────────────
# IBKR: Run Client Portal Gateway on localhost:5000 first
IBKR_GATEWAY_URL=https://localhost:5000

# Schwab: Register at developer.schwab.com
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REFRESH_TOKEN=

# Swissquote
SWISSQUOTE_CLIENT_ID=
SWISSQUOTE_CLIENT_SECRET=
SWISSQUOTE_REFRESH_TOKEN=

# Six B-Link (enterprise — requires Six Group registration)
SIX_BLINK_CERT_PATH=./certs/six-blink.p12
SIX_BLINK_CERT_PASSWORD=
SIX_BLINK_ENDPOINT=https://api.six-group.com/b-link
