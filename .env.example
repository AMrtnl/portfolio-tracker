# Wealth Hub / Portfolio Tracker — Environment Variables
# Copy to `.env` and fill in values. Never commit `.env`.

# API server port (default: 4000)
PORT=4000

# ---------------------------------------------------------------------------
# Secrets (SESSION_SECRET is REQUIRED when NODE_ENV=production)
# ---------------------------------------------------------------------------
# Signs the session cookie (`wh_session`) for every user. With
# NODE_ENV=production and neither SESSION_SECRET nor STORE_SECRET set, the
# server fails closed: every gated route serves 503 instead of portfolio data.
# Locally (NODE_ENV unset) a fixed dev secret is used with a console warning.
# Rotating it signs everyone out. Generate one with `openssl rand -base64 32`.
SESSION_SECRET=

# Encrypts Hyperliquid recovery phrases at rest (AES-GCM) in every user's
# accounts.json. Also the fallback session signing key when SESSION_SECRET is
# unset. Set it once and leave it: changing it makes saved phrases undecryptable.
STORE_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Accounts and sign-up policy
# ---------------------------------------------------------------------------
# Users sign up with an email and password at /signup; each one gets their
# own data directory under DATA_DIR/users/<id>/.
#
# SIGNUP_MODE: open | invite | closed
#   open    anyone can create an account
#   invite  sign-up needs the invite code below
#   closed  no new accounts (existing ones keep working)
# Default: `invite` when INVITE_CODE or APP_PASSWORD is set, otherwise `open`.
# SIGNUP_MODE=invite

# The invite code for SIGNUP_MODE=invite. INVITE_CODE wins if both are set;
# APP_PASSWORD (the old single household password) still works as the code so
# an existing deployment stays invite-only without any change.
# INVITE_CODE=
# APP_PASSWORD=

# Where users.json and each user's directory live. Point this at a mounted
# volume when deploying to a container host, otherwise everything vanishes on
# redeploy. Legacy single-user files found at the root of DATA_DIR are moved
# into the first account that signs up.
# DATA_DIR=/app/data

# ---------------------------------------------------------------------------
# SnapTrade Personal (optional — brokerage aggregation, read-only)
# Free Personal plan: https://dashboard.snaptrade.com
# Create a Personal API key on the dashboard, then set these locally.
# Never commit real values. Never expose CONSUMER_KEY to the browser.
# Personal auth needs NO userId / userSecret.
# Without these keys, Hyperliquid + Manual accounts still work.
# Coverage is strongest in US/CA/UK/EU; many Swiss banks are unsupported —
# use Manual accounts for those.
# ---------------------------------------------------------------------------
# SNAPTRADE_CLIENT_ID=
# SNAPTRADE_CONSUMER_KEY=

# ---------------------------------------------------------------------------
# Legacy / unused by the multi-account UI (wallet is added via Accounts page)
# ---------------------------------------------------------------------------
# MNEMONIC="your twelve or twenty four word mnemonic phrase goes here"

# Future aggregators (not wired yet)
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# GOCARDLESS_SECRET_ID=
# GOCARDLESS_SECRET_KEY=

# Watch-only wallets — public endpoints by default; point at your own node or keyed API
# BTC_API_URL=https://mempool.space/api
# ETH_RPC_URL=https://ethereum-rpc.publicnode.com
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
