# Meridian / Portfolio Tracker — Environment Variables
# Copy to `.env` and fill in values. Never commit `.env`.

# API server port (default: 4000)
PORT=4000

# Encrypts recovery phrases at rest in data/accounts.json
# Change this in any real deployment.
STORE_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Access control (REQUIRED when NODE_ENV=production)
# Single password that gates the app shell and every /api/* route.
# With NODE_ENV=production and no APP_PASSWORD the server fails closed: it
# serves 503 instead of portfolio data. Locally (NODE_ENV unset) the gate is
# off so `npm run server` keeps working without a password.
# Use 24+ random characters, e.g. `openssl rand -base64 24`.
# ---------------------------------------------------------------------------
APP_PASSWORD=

# Optional. Mixed into the session-cookie signing key alongside APP_PASSWORD.
# Rotating either one invalidates all existing sessions.
# SESSION_SECRET=

# Where accounts.json lives. Point this at a mounted volume when deploying to
# a container host, otherwise saved accounts vanish on redeploy.
# DATA_DIR=/app/data

# ---------------------------------------------------------------------------
# SnapTrade Personal (optional — brokerage aggregation, read-only)
# Free Personal plan: https://dashboard.snaptrade.com
# Create a Personal API key on the dashboard, then set these locally.
# Never commit real values. Never expose CONSUMER_KEY to the browser.
# Personal auth needs NO userId / userSecret.
# Without these keys, Hyperliquid + Manual accounts still work.
# Coverage is strongest in US/CA/UK/EU; many Swiss banks are unsupported —
# use Manual accounts for those.
# ---------------------------------------------------------------------------
# SNAPTRADE_CLIENT_ID=
# SNAPTRADE_CONSUMER_KEY=

# ---------------------------------------------------------------------------
# Legacy / unused by the multi-account UI (wallet is added via Accounts page)
# ---------------------------------------------------------------------------
# MNEMONIC="your twelve or twenty four word mnemonic phrase goes here"

# Future aggregators (not wired yet)
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# GOCARDLESS_SECRET_ID=
# GOCARDLESS_SECRET_KEY=
