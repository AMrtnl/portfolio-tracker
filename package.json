{
  "name": "portfolio-tracker",
  "version": "1.0.0",
  "description": "A comprehensive portfolio tracker with Hyperliquid and DeFi integration",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc",
    "build:client": "npm ci --prefix client && npm run build --prefix client",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "start:cli": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "server": "ts-node src/server.ts",
    "test": "jest",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "axios": "^1.6.2",
    "bip39": "^3.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ethers": "^6.9.0",
    "ethers-multicall-provider": "^1.3.0",
    "express": "^4.18.2",
    "hyperliquid": "^1.7.7",
    "playwright": "^1.62.1",
    "snaptrade-typescript-sdk": "^11.0.4",
    "web3": "^4.2.2",
    "ws": "^8.14.2",
    "yahoo-finance2": "^4.0.0"
  },
  "devDependencies": {
    "@types/bip39": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "crypto",
    "portfolio",
    "hyperliquid",
    "defi",
    "blockchain"
  ]
}
